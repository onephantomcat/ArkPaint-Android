<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_eyebrow"
            android:textAppearance="@style/TextAppearance.ArkPaint.Eyebrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/app_title"
            android:textAppearance="@style/TextAppearance.ArkPaint.Display"
            android:textSize="36sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ArkPaint.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot" />

                    <TextView
                        android:id="@+id/imageStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/status_no_image"
                        android:textColor="@color/paper"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/colorCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_zero_colors"
                        android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />
                </LinearLayout>

                <TextView
                    android:id="@+id/serviceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/status_service_off"
                    android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />

                <TextView
                    android:id="@+id/calibrationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/status_uncalibrated"
                    android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preview_label"
            android:textAppearance="@style/TextAppearance.ArkPaint.Eyebrow" />

        <com.eraser2333.arkpaint.ui.PixelPreviewView
            android:id="@+id/pixelPreview"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/preview_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importButton"
                style="@style/Widget.ArkPaint.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/import_image" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportButton"
                style="@style/Widget.ArkPaint.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/export_image" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cropButton"
            style="@style/Widget.ArkPaint.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/adjust_crop" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ArkPaint.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/image_settings"
                    android:textColor="@color/paper"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/resize_mode"
                    android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />

                <Spinner
                    android:id="@+id/resizeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/resampling_method"
                    android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />

                <Spinner
                    android:id="@+id/resamplingSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mapping_method"
                    android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />

                <Spinner
                    android:id="@+id/mappingSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/pixel_merge"
                    android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />

                <Spinner
                    android:id="@+id/mergeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/transparent_color"
                    android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />

                <Spinner
                    android:id="@+id/transparentSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dropdown" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ditherSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/dither"
                    android:textColor="@color/paper" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sharpness"
                        android:textColor="@color/paper" />

                    <TextView
                        android:id="@+id/sharpnessValue"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/sharpness_default"
                        android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sharpnessSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="35" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brightness"
                        android:textColor="@color/paper" />

                    <TextView
                        android:id="@+id/brightnessValue"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/value_zero"
                        android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/brightnessSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200"
                    android:progress="100" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/contrast"
                        android:textColor="@color/paper" />

                    <TextView
                        android:id="@+id/contrastValue"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/value_zero"
                        android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/contrastSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200"
                    android:progress="100" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/saturation"
                        android:textColor="@color/paper" />

                    <TextView
                        android:id="@+id/saturationValue"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/value_zero"
                        android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/saturationSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200"
                    android:progress="100" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tap_delay"
                        android:textColor="@color/paper" />

                    <TextView
                        android:id="@+id/tapDelayValue"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/tap_delay_default"
                        android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/tapDelaySeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="190"
                    android:progress="40" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetButton"
                    style="@style/Widget.ArkPaint.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/reset_adjustments" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ArkPaint.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:strokeColor="@color/rhodes_cyan_dim">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/automation_title"
                    android:textColor="@color/paper"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/automation_explainer"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accessibilityButton"
                    style="@style/Widget.ArkPaint.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/open_accessibility" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlayPermissionButton"
                    style="@style/Widget.ArkPaint.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_permission_xiaomi" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/showOverlayButton"
                    style="@style/Widget.ArkPaint.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/show_overlay" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/prepareButton"
                    style="@style/Widget.ArkPaint.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/prepare_pattern" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/footer_notice"
            android:textAppearance="@style/TextAppearance.ArkPaint.Utility" />
    </LinearLayout>
</ScrollView>
