<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/overlayDragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="@string/overlay_title"
            android:textColor="@color/rhodes_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayOpenApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="3dp"
            android:text="@string/overlay_open_app"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlayStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:minHeight="32dp"
        android:text="@string/overlay_idle"
        android:textColor="@color/paper"
        android:textSize="12sp" />

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/overlayCalibrate"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="9dp"
            android:text="@string/overlay_calibrate"
            android:textSize="11sp" />

        <Button
            android:id="@+id/overlayVerify"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="9dp"
            android:text="@string/overlay_verify"
            android:textSize="11sp" />

        <Button
            android:id="@+id/overlayDraw"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="9dp"
            android:text="@string/overlay_draw"
            android:textSize="11sp" />

        <Button
            android:id="@+id/overlayPause"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="9dp"
            android:text="@string/overlay_pause"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/overlayResume"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="9dp"
            android:text="@string/overlay_resume"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/overlayStop"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="9dp"
            android:text="@string/overlay_stop"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
