<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ArkPaint" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/rhodes_cyan</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/success</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorPrimaryContainer">@color/rhodes_cyan_container</item>
        <item name="colorOnPrimaryContainer">@color/rhodes_cyan</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/paper</item>
        <item name="colorSurfaceVariant">@color/panel_raised</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/grid</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:colorAccent">@color/rhodes_cyan</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@color/ink</item>
    </style>

    <style name="TextAppearance.ArkPaint.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.ArkPaint.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/rhodes_cyan</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="TextAppearance.ArkPaint.Utility" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextAppearance.ArkPaint.Section" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/paper</item>
    </style>

    <style name="TextAppearance.ArkPaint.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.ArkPaint.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_container</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.ArkPaint.Card.Emphasized" parent="Widget.ArkPaint.Card">
        <item name="cardBackgroundColor">@color/surface_container_high</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="strokeColor">@color/rhodes_cyan_dim</item>
    </style>

    <style name="Widget.ArkPaint.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/rhodes_cyan</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.ArkPaint.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/grid</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.ArkPaint.TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/rhodes_cyan_container</item>
        <item name="android:textColor">@color/rhodes_cyan</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
    </style>
</resources>
